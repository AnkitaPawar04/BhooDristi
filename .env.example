# BhooDristi root environment template
# Copy needed values into backend/.env and frontend/.env
# Do NOT commit real secrets.

# =========================
# Backend variables
# =========================
DATABASE_URL=postgresql://user:password@localhost:5432/BhooDristi
SECRET_KEY=replace_with_a_long_random_secret
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
ENVIRONMENT=development

# =========================
# Frontend variables
# =========================
VITE_BACKEND_URL=http://localhost:8000

# Optional Firebase values (only if you enable Firebase again)
# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_GOOGLE_CLIENT_ID=your_google_client_id
